# NEXA environment configuration
# Copy to .env and fill in values before running the app.
# Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexa
DB_USER=postgres
DB_PASSWORD=replace-with-a-real-local-password

# Optional: full SQLAlchemy URL. Takes precedence over the DB_* values above.
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nexa

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Disposable test database override. Leave unset unless debugging tests.
# TEST_DATABASE_NAME=nexa_test_manual

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# OpenAI is used for "gpt-*" and "openai/<model>".
OPENAI_API_KEY=
# Optional override for OpenAI-compatible gateways/proxies.
OPENAI_BASE_URL=

# Groq is used for "groq/<model>".
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# xAI Grok is used for "xai/<model>", "grok/<model>", and "grok-*".
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Used by the LiveKit voice worker for local Ollama models.
OLLAMA_HOST=http://localhost:11434

# Embeddings: auto uses fastembed (local ONNX, ~6ms/query, free).
# ollama is local but ~2s/query; deterministic is the legacy hash client.
EMBEDDING_PROVIDER=auto

# Shared request controls for OpenAI-compatible clients.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# LiveKit voice
# ---------------------------------------------------------------------------
# Development defaults only. Use a strong secret for any shared deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# STT (faster-whisper)
# ---------------------------------------------------------------------------
# auto uses Groq when GROQ_API_KEY is set, otherwise local faster-whisper.
# groq is far faster and more accurate on CPU-only machines; local stays as fallback.
STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3-turbo
# tiny.en | base.en | small.en | medium | large-v3
# For live voice, tiny.en/base.en are far faster on CPU than multilingual base.
WHISPER_MODEL_SIZE=tiny.en
# Setting the language skips Whisper's auto-detection pass (a large latency cost).
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# TTS (piper)
# ---------------------------------------------------------------------------
PIPER_VOICE=en_US-lessac-medium
PIPER_MODELS_DIR=./voice_models
# Prosody: slightly slower with mild variation sounds less robotic.
# Raise length_scale for slower speech; raise noise scales for more variation.
PIPER_LENGTH_SCALE=1.05
PIPER_NOISE_SCALE=0.75
PIPER_NOISE_W_SCALE=0.85

# ---------------------------------------------------------------------------
# Turn detection
# ---------------------------------------------------------------------------
# Lower values shorten the pause after you stop talking before the reply starts.
# EOT verdicts below veto premature commits, so this can stay short.
VAD_MIN_SILENCE_SECONDS=0.15
VAD_ACTIVATION_THRESHOLD=0.5

# Local end-of-turn model (livekit-local-inference, no network call).
# It decides "are they done?" from the last 1.2 s of speech instead of relying
# on silence alone. Lower the threshold to commit sooner, raise it to wait
# longer. Watch the "EOT verdict probability" log to tune for your users.
VAD_EOT_ENABLED=true
VAD_EOT_THRESHOLD=0.2
# Hard cap on how long an unsure verdict may hold the turn. Keep it short;
# raising it avoids cut-offs at long pauses but adds latency.
VAD_EOT_MAX_WAIT_SECONDS=0.8

# ---------------------------------------------------------------------------
# Security headers & rate limiting
# ---------------------------------------------------------------------------
# In-memory, per-process sliding-window limiter. Suitable for a single API
# instance; for multi-instance deployments, front the API with a proxy that
# does its own limiting, or swap in a Redis-backed limiter.
RATE_LIMIT_ENABLED=true
# Only these addresses may set X-Forwarded-For. Leave empty for direct clients.
# Comma-separated IPs or CIDRs, e.g. 127.0.0.1,10.0.0.0/8
# In production behind a proxy, set this to the proxy address seen by the API.
TRUSTED_PROXY_HOSTS=
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=10
RATE_LIMIT_INVITES_PER_HOUR=30
RATE_LIMIT_AGENT_RUN_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=30

# ---------------------------------------------------------------------------
# API behavior
# ---------------------------------------------------------------------------
# Comma-separated origins. "*" is acceptable for local development only.
CORS_ORIGINS=*
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Agent, memory, and RAG tuning
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=5
MEMORY_HISTORY_LIMIT=20
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
