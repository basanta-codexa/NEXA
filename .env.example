# NEXA environment configuration
# Copy to .env and fill in values before running the app.
# Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexa
DB_USER=postgres
DB_PASSWORD=replace-with-a-real-local-password

# Optional: full SQLAlchemy URL. Takes precedence over the DB_* values above.
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nexa

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Disposable test database override. Leave unset unless debugging tests.
# TEST_DATABASE_NAME=nexa_test_manual

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# OpenAI is used for "gpt-*" and "openai/<model>".
OPENAI_API_KEY=
# Optional override for OpenAI-compatible gateways/proxies.
OPENAI_BASE_URL=

# Groq is used for "groq/<model>".
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# xAI Grok is used for "xai/<model>", "grok/<model>", and "grok-*".
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Used by the LiveKit voice worker for local Ollama models.
OLLAMA_HOST=http://localhost:11434

# Shared request controls for OpenAI-compatible clients.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# LiveKit voice
# ---------------------------------------------------------------------------
# Development defaults only. Use a strong secret for any shared deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# STT (faster-whisper)
# ---------------------------------------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# TTS (piper)
# ---------------------------------------------------------------------------
PIPER_VOICE=en_US-lessac-medium
PIPER_MODELS_DIR=./voice_models

# ---------------------------------------------------------------------------
# Turn detection
# ---------------------------------------------------------------------------
VAD_MIN_SILENCE_SECONDS=0.55
VAD_ACTIVATION_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# API behavior
# ---------------------------------------------------------------------------
# Comma-separated origins. "*" is acceptable for local development only.
CORS_ORIGINS=*
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Agent, memory, and RAG tuning
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=5
MEMORY_HISTORY_LIMIT=20
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
