# ─────────────────────────────────────────────────────────────────────────────
# NEXA environment configuration
# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexa
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: full SQLAlchemy URL. Takes precedence over the DB_* values above.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nexa

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM providers ─────────────────────────────────────────────────────────────
# Agents using "gpt-*" or "openai/*" need this. "fake" and "ollama/*" do not.
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ── LiveKit voice ─────────────────────────────────────────────────────────────
# Self-hosted dev server defaults (see voice/docker-compose.livekit.yml).
# Use the same key/secret for the LiveKit server, API, and worker.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ── STT (faster-whisper) ──────────────────────────────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── TTS (piper) ───────────────────────────────────────────────────────────────
# Voice list: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_US-lessac-medium
# Keep this outside the repo in production. The worker downloads models here.
PIPER_MODELS_DIR=./voice_models

# ── Turn detection ────────────────────────────────────────────────────────────
VAD_MIN_SILENCE_SECONDS=0.55
VAD_ACTIVATION_THRESHOLD=0.5

# ── API behaviour ─────────────────────────────────────────────────────────────
# Comma-separated origins; "*" allows any origin (no cookies/credentials).
CORS_ORIGINS=*
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# ── Agent / memory / RAG tuning ───────────────────────────────────────────────
AGENT_MAX_ITERATIONS=5
MEMORY_HISTORY_LIMIT=20
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
